{
  "name": "laiganjue",
  "version": "1.0.0",
  "private": true,
  "description": "来感觉 · 玄学占卜合集 —— 筊杯 / 灵签 / 六爻 / 黄历 / 八字 / 风水 / 转盘 / 塔罗 / 卢恩 / 星座 / 水晶球 / 御神签 / 硬币骰子 / 落球盘",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:app": "node scripts/build.mjs --out www --app",
    "app:sync": "npm run build:app && cap sync",
    "app:android": "npm run app:sync && cap open android",
    "app:ios": "npm run app:sync && cap open ios",
    "e2e": "node --test --test-concurrency=1 --test-reporter=spec tests/e2e/*.e2e.mjs",
    "gallery:3d": "node scripts/stage-gallery.mjs --themes paper,ink"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2",
    "playwright": "1.63.0"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/share": "8.0.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/native-purchases": "8.9.6",
    "three": "0.180.0"
  }
}
